## 10. 反面案例

```typescript
// ❌ 多重问题：any 泛滥、无运行时校验、强断言、悬空 Promise
function fetchUser(id: any) {
  fetch('/api/user/' + id)
    .then(r => r.json())
    .then(data => {
      const user = data as User;
      console.log(user.email.toLowerCase());  // email 可能 undefined
    });
}

// ✅ 类型安全 + 运行时校验 + 错误处理
async function fetchUser(id: number): Promise<User> {
  const r = await fetch(`/api/user/${id}`);
  if (!r.ok) throw new BizError('FETCH_FAIL', `HTTP ${r.status}`);
  const json: unknown = await r.json();
  return UserSchema.parse(json);
}
```

```typescript
// ❌ 悬空 Promise
app.get('/users', (req, res) => {
  userService.find(req.query.id);  // 无 await，错误吞掉
  res.json({ ok: true });
});

// ✅ await + try/catch
app.get('/users', async (req, res) => {
  try {
    const user = await userService.find(req.query.id);
    res.json(user);
  } catch (e) {
    next(e);
  }
});
```

