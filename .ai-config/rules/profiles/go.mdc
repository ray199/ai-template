## 12. 反面案例

```go
// ❌ goroutine 泄漏 + ctx 未传 + 错误忽略
func handleBackground(id int) {
    go func() {
        data, _ := fetchFromAPI(id)  // 没 ctx、忽略 err
        process(data)                // 永远不会退出
    }()
}

// ✅
func handleBackground(ctx context.Context, id int) error {
    go func() {
        data, err := fetchFromAPI(ctx, id)
        if err != nil {
            slog.ErrorContext(ctx, "fetch failed", "id", id, "err", err)
            return
        }
        process(data)
    }()
    return nil
}
```

```go
// ❌ 默认 client 无超时 + 无错误包装
resp, err := http.Get(url)
if err != nil { return err }

// ✅ 自定义 client + 错误包装
var client = &http.Client{ Timeout: 5 * time.Second }
req, _ := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)
resp, err := client.Do(req)
if err != nil { return fmt.Errorf("call %s: %w", url, err) }
defer resp.Body.Close()
```

