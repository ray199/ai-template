## 2. API 风格规范

### Controller-based（经典风格，推荐中大型项目）

```csharp
[ApiController]
[Route("api/v1/[controller]")]
public class UsersController : ControllerBase
{
    private readonly IUserService _svc;
    public UsersController(IUserService svc) => _svc = svc;

    [HttpGet("{id:int}")]
    [ProducesResponseType<ApiResponse<UserDto>>(200)]
    [ProducesResponseType(404)]
    public async Task<IActionResult> GetById(int id)
    {
        var user = await _svc.GetByIdAsync(id);
        return user is null ? NotFound() : Ok(ApiResponse.Success(user));
    }
}

// ✅ 统一响应体
public record ApiResponse<T>(int Code, string Msg, T? Data)
{
    public static ApiResponse<T> Success(T data) => new(200, "success", data);
    public static ApiResponse<T> Fail(string msg) => new(400, msg, default);
}
```

### Minimal API（推荐轻量服务 / .NET 6+）

```csharp
// ✅ 分模块注册（避免 Program.cs 膨胀）
public static class UserEndpoints
{
    public static void MapUserEndpoints(this IEndpointRouteBuilder app)
    {
        var group = app.MapGroup("/api/v1/users").WithTags("Users");
        group.MapGet("/{id:int}", GetById);
        group.MapPost("/", Create);
    }

    private static async Task<IResult> GetById(int id, IUserService svc)
        => await svc.GetByIdAsync(id) is { } user
            ? Results.Ok(ApiResponse.Success(user))
            : Results.NotFound();
}
```

