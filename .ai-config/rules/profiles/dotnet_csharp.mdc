## 5. 测试规范

```csharp
// ✅ xUnit + Moq + FluentAssertions（推荐组合）
public class UserServiceTests
{
    private readonly Mock<IUserRepository> _repoMock = new();
    private readonly UserService _sut;

    public UserServiceTests()
    {
        _sut = new UserService(_repoMock.Object, NullLogger<UserService>.Instance);
    }

    [Fact]
    public async Task GetByIdAsync_UserExists_ReturnsUser()
    {
        // Arrange
        var expected = new User { Id = 1, Username = "test" };
        _repoMock.Setup(r => r.FindByIdAsync(1)).ReturnsAsync(expected);

        // Act
        var result = await _sut.GetByIdAsync(1);

        // Assert
        result.Should().BeEquivalentTo(expected);
    }

    [Fact]
    public async Task GetByIdAsync_UserNotFound_ReturnsNull()
    {
        _repoMock.Setup(r => r.FindByIdAsync(It.IsAny<int>())).ReturnsAsync((User?)null);
        var result = await _sut.GetByIdAsync(999);
        result.Should().BeNull();
    }
}
```

