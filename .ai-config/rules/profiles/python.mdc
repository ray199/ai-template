## 5. 测试规范

```python
# ✅ pytest + pytest-asyncio（FastAPI 推荐）
import pytest
from httpx import AsyncClient

@pytest.mark.asyncio
async def test_create_user_success(client: AsyncClient):
    response = await client.post("/api/v1/user", json={"username": "test", "email": "test@example.com"})
    assert response.status_code == 200
    assert response.json()["code"] == 200

@pytest.mark.asyncio
async def test_create_user_duplicate(client: AsyncClient):
    # given: user already exists
    await client.post("/api/v1/user", json={"username": "test", "email": "test@example.com"})
    # when: create again
    response = await client.post("/api/v1/user", json={"username": "test", "email": "test2@example.com"})
    # then
    assert response.status_code == 400
```

