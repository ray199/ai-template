## 15. 反面案例

```tsx
// ❌ 多重问题：any 类型、index key、内联函数导致 re-render、useEffect 做派生
function UserList({ users }: { users: any[] }) {
  const [filtered, setFiltered] = useState([]);
  useEffect(() => {
    setFiltered(users.filter(u => u.active));
  }, [users]);

  return filtered.map((u, i) => (
    <UserItem key={i} user={u} onClick={() => console.log(u)} />
  ));
}

// ✅ 类型安全 + 渲染中派生 + 稳定 key + useCallback
interface Props { users: User[]; onSelect: (u: User) => void }
function UserList({ users, onSelect }: Props) {
  const filtered = useMemo(() => users.filter(u => u.active), [users]);
  return filtered.map(u => (
    <UserItem key={u.id} user={u} onClick={onSelect} />
  ));
}
```

```tsx
// ❌ 在 onClick 里做异步且不处理并发
<button onClick={async () => {
  const res = await api.buy(item);
  setResult(res);
}}>购买</button>

// ✅ 防重复点击 + 错误处理
const [loading, setLoading] = useState(false);
const onBuy = async () => {
  if (loading) return;
  setLoading(true);
  try { setResult(await api.buy(item)); }
  catch (e) { toast.error('购买失败'); }
  finally { setLoading(false); }
};
<button onClick={onBuy} disabled={loading}>购买</button>
```

